{
  "name": "node-js-getting-started",
  "version": "0.3.0",
  "description": "A sample jwt auth Node.js app using Express 4 for microservices apps",
  "engines": {
    "node": ">=18.x",
    "npm": ">=9.x"
  },
  "main": "index.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "test": "jest --verbose --coverage --forceExit --maxWorkers=1",
    "lintfix": "eslint \"**/*.js\" --fix",
    "lint": "eslint \"**/*.js\""
  },
  "dependencies": {
    "@babel/eslint-parser": "^7.25.7",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mongoose": "^6.13.10"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "overrides": {
    "brace-expansion": "^2.0.1"
  },
  "eslintConfig": {
    "extends": "airbnb-base",
    "env": {
      "es6": true,
      "browser": true,
      "node": true,
      "jest": true
    },
    "overrides": [
      {
        "files": [
          "test/**/*.js",
          "**/*.test.js",
          "jest.setup.js",
          "testConfig.js"
        ],
        "rules": {
          "import/no-extraneous-dependencies": "off",
          "import/order": "off",
          "import/newline-after-import": "off",
          "no-shadow": "off",
          "no-multiple-empty-lines": "off"
        }
      }
    ],
    "rules": {
      "brace-style": [
        "error",
        "stroustrup"
      ],
      "comma-dangle": [
        "error",
        "never"
      ],
      "no-unused-vars": [
        "warn"
      ],
      "no-var": [
        "off"
      ],
      "one-var": [
        "off"
      ],
      "import/extensions": "off"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/node-js-getting-started"
  },
  "keywords": [
    "node",
    "heroku",
    "express"
  ],
  "license": "MIT"
}
